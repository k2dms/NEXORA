{
  "name": "@nexora/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "verify": "node --test src/*.test.ts",
    "verify:browser": "node scripts/browser-golden.mjs",
    "build": "npm run check && vite build && node scripts/package.mjs"
  },
  "dependencies": {
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/chrome": "0.1.43",
    "@types/node": "24.19.2",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
