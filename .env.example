# NEXORA live-verification environment.
# Copy to .env, fill in, and never commit .env.
#
# Every variable below gates specific LIVE rows in
# docs/verification/live-env-contract.md. A missing variable makes those rows
# report SKIPPED -- never PASSED. Rows are only promotable to PASSED by an
# executed check, per docs/adr/0020.

# --- VLESS server under test -------------------------------------------------
# Address of the Xray server: hostname or IP.
NEXORA_VLESS_ADDR=
NEXORA_VLESS_PORT=

# The UUID the server expects. Gated: LIVE-05..LIVE-09, LIVE-10, LIVE-11.
NEXORA_VLESS_UUID=

# One of: "" (none) or xtls-rprx-vision. Only legal with network=tcp +
# security=tls; the config compiler must reject any other combination.
# Gated: LIVE-05.
NEXORA_VLESS_FLOW=

# Transport: tcp | ws | grpc | xhttp | h2. Set one per run; the matrix walks
# them. Gated: LIVE-05 (tcp), LIVE-06 (ws), LIVE-07 (grpc), LIVE-08 (xhttp).
NEXORA_VLESS_NETWORK=

# Security layer: none | tls | reality. Gated: LIVE-05..LIVE-09.
NEXORA_VLESS_SECURITY=

# TLS / REALITY parameters. Gated: LIVE-05..LIVE-09.
NEXORA_VLESS_SNI=
NEXORA_VLESS_ALPN=
NEXORA_VLESS_FINGERPRINT=

# REALITY only. Gated: LIVE-09. The private key belongs to the server operator
# and is NOT required here -- supply only what a client needs.
NEXORA_VLESS_PUBLIC_KEY=
NEXORA_VLESS_SHORT_ID=
NEXORA_VLESS_SPIDER_X=

# --- Egress assertion --------------------------------------------------------
# An HTTPS endpoint returning the caller's public IP, used to prove that traffic
# actually left through the VPS rather than directly. No LIVE row may report
# PASSED without this check having run. Gated: LIVE-04, LIVE-05..LIVE-09.
NEXORA_EGRESS_PROBE=

# The public IP (or a JSON field selector plus expected value) that
# NEXORA_EGRESS_PROBE must report when traffic is routed through the server.
# Gated: LIVE-04.
NEXORA_EXPECTED_EGRESS_IP=

# --- Xray binary acquisition -------------------------------------------------
# Path to an already-installed Xray binary, to skip download in CI. When unset,
# integrity checks run against the pinned release instead. Gated: LIVE-02.
NEXORA_XRAY_BIN=
