node_modules
bower_components
package-lock.json
*-release.zip
*.swp

# Live-verification secrets. Only .env.example is tracked.
.env
.env.*
!.env.example

# Scratch and build staging: the legacy grunt chain writes tmp/{chromium,firefox} during
# `grunt release`, and this iteration writes measurement scripts there. Neither is a deliverable.
tmp/

# The release directory the hub writes: two zips plus the checksum file .github/workflows/verify.yml
# produces beside them. Build output, never a committed artifact (constraint: no binaries in git).
dist/

# The Go connector builds here. `connector/` MUST NOT carry a compiled binary in git
# (docs/architecture/20-target-repository-layout.md §3); this is where `go build -o bin/` writes.
connector/bin/

# ADR-0019 rule 6: no committed binaries
*.exe
