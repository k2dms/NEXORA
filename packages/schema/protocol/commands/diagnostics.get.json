{
  "name": "diagnostics.get",
  "title": "Bounded, masked diagnostic dump",
  "summary": "One call must be enough to answer 'why is my traffic not going through Xray right now' (docs/architecture/36). Everything it returns is masked at the sink, size-bounded and ring-buffered: an unbounded dump is a crash and an unmasked one is a leak.",
  "class": "read",
  "idempotent": true,
  "replayable": true,
  "timeoutMs": 15000,
  "requiresHello": true,
  "capabilities": ["diagnostics.redacted"],
  "args": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "include": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "uniqueItems": true,
        "items": {
          "enum": [
            "core-log",
            "connector-log",
            "events",
            "config-snapshot",
            "health",
            "inbounds",
            "versions",
            "pins",
            "routing-decisions",
            "failure-policy"
          ]
        }
      },
      "maxBytes": { "type": "integer", "minimum": 4096, "maximum": 4194304, "default": 1048576 },
      "sinceSeq": { "type": ["integer", "null"], "minimum": 0 },
      "format": { "enum": ["json", "jsonl"], "default": "json" }
    }
  },
  "result": {
    "type": "object",
    "additionalProperties": false,
    "required": ["sections", "masked", "truncated"],
    "properties": {
      "generatedAt": { "type": "string", "format": "date-time" },
      "sections": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "state"],
          "properties": {
            "name": { "type": "string" },
            "state": { "enum": ["ok", "empty", "unavailable", "not-capable"] },
            "bytes": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string", "maxLength": 160 }
          }
        }
      },
      "masked": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fieldsReplaced"],
        "properties": {
          "fieldsReplaced": { "type": "integer", "minimum": 0 },
          "fingerprints": {
            "type": "array",
            "maxItems": 256,
            "items": { "type": "string", "pattern": "^fp-[0-9a-f]{12}$" },
            "description": "Irreversible short hashes of the masked values, so support can say 'the UUID you sent is not the one on file' without either value appearing."
          }
        }
      },
      "truncated": { "type": "boolean" },
      "payload": { "type": ["object", "null"] }
    }
  },
  "errors": ["SecretRedacted", "DiskFull", "QuotaExceeded", "Timeout", "UnauthorizedExtension", "Internal"],
  "sideEffects": ["none"],
  "invariants": [
    "No secret value leaves this call, including keystore contents; only field names and fingerprints do (ADR-0010, LIVE-10)."
  ]
}
